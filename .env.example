# PostHog product analytics.
# Copy this file to .env.local and fill in the key. .env.local stays untracked.
#
# Analytics are OFF while VITE_PUBLIC_POSTHOG_KEY is empty: the app runs normally and sends
# nothing. This is the public, write-only project key (safe in frontend code), not a personal
# API key. Get it in PostHog: Settings -> Project -> Project ID / API key.
VITE_PUBLIC_POSTHOG_KEY=

# Ingestion host. Defaults to PostHog Cloud US when unset, which is where this
# project's PostHog instance lives. Set it only to point somewhere else.
# US: https://us.i.posthog.com   EU: https://eu.i.posthog.com
VITE_PUBLIC_POSTHOG_HOST=
